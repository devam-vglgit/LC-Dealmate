# Copy to backend/.env and fill in. Never commit the real .env — it is gitignored.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Portal login. Leave both blank to disable auth entirely (the API is then open).
LC_AUTH_USERNAME=changeme
LC_AUTH_PASSWORD=changeme

# Signs session tokens. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random one is generated at startup and logins won't survive a restart.
LC_SESSION_SECRET=
LC_SESSION_HOURS=12

# Optional model tuning.
# LC_MODEL=claude-opus-5
# LC_EFFORT=high
# LC_MAX_TOKENS=16000
# LC_ENABLE_FALLBACK=1
