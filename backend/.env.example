# Copy to backend/.env and fill in. Never commit the real .env — it is gitignored.

# Required: your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional local username/password (dev only). Leave both blank when CMS is
# the only way in — the iframe JWT is then the sole login.
# LC_AUTH_USERNAME=
# LC_AUTH_PASSWORD=

# Signs DealMate session tokens after CMS handoff (or after local login).
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# CMS may inject SESSION_SECRET instead; either name works.
LC_SESSION_SECRET=
LC_SESSION_HOURS=12

# CMS iframe handoff. CMS mints HS256 JWT { sub, exp } with this secret and
# opens DealMate as /?token=<jwt>&contract=<uuid>. Same value as CMS
# CMS_EMBED_SECRET, or reuse SSO_JWT_SECRET if CMS already has one.
CMS_EMBED_SECRET=
# SSO_JWT_SECRET=

# ShopLC CMS Postgres. On the CMS Docker network this is the production path:
# DATABASE_URL=postgresql://cms_app_uat:PASSWORD@cms-uat-postgres-uat-1:5432/cms_uat
#
# Local Windows fallback (no DATABASE_URL): docker exec into CMS_PG_DOCKER.
# CMS_PG_DOCKER=cms-uat-postgres-uat-1
# CMS_PG_USER=cms_app_uat
# CMS_PG_DATABASE=cms_uat
# Set CMS_PG_DOCKER empty in the DealMate container so it never shells out:
# CMS_PG_DOCKER=
# CMS_CACHE_SECONDS=120

# Azure Blob + AES key — same values CMS uses. Inject from the CMS stack.
# Used only to stream PDFs to the browser; never sent to the model.
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=contracts
# DATA_ENCRYPTION_KEY_HEX_V1=

# Origins allowed to iframe DealMate (CSP frame-ancestors).
# LC_FRAME_ANCESTORS=https://contractsuat.shoplc.com https://contracts.shoplc.com http://localhost:38090
# Extra CORS origins, comma-separated.
# LC_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Does the AI get to see the contracts?
#
# 0 (default) — it does not. The model is told the portfolio is withheld and
#   can only work from what the user types.
#
# 1 — de-identified rows via app/redact.py, plus a short CMS excerpt for the
#   open contract. Never PDFs, never full document text, never ShopLC identity.
#
# Request Zero Data Retention from Anthropic before switching this on.
LC_SEND_CONTRACTS_TO_MODEL=0

# Optional model tuning.
# LC_MODEL=claude-opus-5
# LC_EFFORT=high
# LC_MAX_TOKENS=16000
# LC_ENABLE_FALLBACK=1
# Searches per question plus live page fetches of official URLs.
# LC_WEB_SEARCH_MAX_USES=25
# LC_MAX_CONTINUATIONS=16
