# Copy to frontend/.env for local Vite only. Not used when FastAPI serves frontend/dist.

# Backend port the dev server proxies /api to — match LC_PORT / uvicorn.
LC_API_PORT=8101

# Port the Vite dev server listens on.
LC_UI_PORT=5173

# Leave unset for local Vite and for CMS (same-origin SPA). Never put secrets here.
VITE_API_BASE=
