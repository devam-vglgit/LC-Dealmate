# Copy to frontend/.env for local development.

# Backend port the dev server proxies /api to — match LC_PORT in backend/.env.
LC_API_PORT=8101

# Port the Vite dev server listens on.
LC_UI_PORT=5173

# Where the FastAPI backend lives, used at BUILD time by Vite.
#
# Leave unset for local development — vite.config.js proxies /api to localhost.
# Set it in Netlify (Site settings → Environment variables) to your backend's
# public URL, with no trailing slash:
#   VITE_API_BASE=https://lc-dealmate-api.onrender.com
#
# ⚠️ Anything VITE_-prefixed is compiled into the JavaScript users download.
# Never put ANTHROPIC_API_KEY or the portal password here — those belong on the
# backend host only.
VITE_API_BASE=
